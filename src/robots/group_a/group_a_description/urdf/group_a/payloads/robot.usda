#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.1.3"
    }
    defaultPrim = "combined_system"
    doc = """Generated from Composed Stage of root layer /tmp/tmpfq1l8btm/combined_system.usdc


Generated from Composed Stage of root layer /tmp/urdf_import_group_a_w_yju7mr/usdex_group_a/combined_system.usdc


Generated from Composed Stage of root layer /tmp/urdf_import_group_a_w_yju7mr/temp_group_a/group_a.usd
"""
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

over "combined_system" (
    prepend apiSchemas = ["IsaacRobotAPI"]
)
{
    prepend rel isaac:physics:robotJoints = [
        </combined_system/Physics/tn__lift_plate_joint_tO>,
        </combined_system/Physics/tn__lift_base_joint_dN>,
        </combined_system/Physics/tn__lift_lower_joint_tO>,
        </combined_system/Physics/tn__lift_upper_joint_tO>,
        </combined_system/Physics/tn__lift__mount_link_joint_wX0>,
    ]
    prepend rel isaac:physics:robotLinks = [
        </combined_system/Geometry/world/tn__lift_plate_link_dN>,
        </combined_system/Geometry/world/tn__lift_plate_link_dN/tn__lift_base_link_sL>,
        </combined_system/Geometry/world/tn__lift_plate_link_dN/tn__lift_base_link_sL/tn__lift_lower_link_dN>,
        </combined_system/Geometry/world/tn__lift_plate_link_dN/tn__lift_base_link_sL/tn__lift_lower_link_dN/tn__lift_upper_link_dN>,
        </combined_system/Geometry/world/tn__lift_plate_link_dN/tn__lift_base_link_sL/tn__lift_lower_link_dN/tn__lift_upper_link_dN/tn__lift_mount_link_dN>,
    ]
    token isaac:robotType = "Default"

    over "Geometry"
    {
        over "world"
        {
            over "tn__lift_plate_link_dN" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "plate" (
                    prepend apiSchemas = ["IsaacSiteAPI"]
                )
                {
                }

                over "tn__lift_base_link_sL" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                    over "base" (
                        prepend apiSchemas = ["IsaacSiteAPI"]
                    )
                    {
                    }

                    over "tn__lift_lower_link_dN" (
                        prepend apiSchemas = ["IsaacLinkAPI"]
                    )
                    {
                        over "lower" (
                            prepend apiSchemas = ["IsaacSiteAPI"]
                        )
                        {
                        }

                        over "tn__lift_upper_link_dN" (
                            prepend apiSchemas = ["IsaacLinkAPI"]
                        )
                        {
                            over "upper" (
                                prepend apiSchemas = ["IsaacSiteAPI"]
                            )
                            {
                            }

                            over "tn__lift_mount_link_dN" (
                                prepend apiSchemas = ["IsaacLinkAPI"]
                            )
                            {
                                over "mount" (
                                    prepend apiSchemas = ["IsaacSiteAPI"]
                                )
                                {
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    over "Physics"
    {
        over "tn__lift_plate_joint_tO" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "tn__lift_base_joint_dN" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "tn__lift_lower_joint_tO" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "tn__lift_upper_joint_tO" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "tn__lift__mount_link_joint_wX0" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }
    }
}

