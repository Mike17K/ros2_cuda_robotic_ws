<?xml version="1.0" encoding="UTF-8"?>
<!-- SRDF for the combined system 
    manualy converted from the original SRDF file generated by MoveIt Setup Assistant from
group_a_moveit_config package. The original file is located at:
    src/robots/group_a/group_a_moveit_config/config/combined_system.srdf
-->
<robot xmlns:xacro="http://ros.org" name="combined_system">

    <!-- Ορισμός παραμέτρου prefix (κενό ως προεπιλογή) -->
    <xacro:arg name="prefix" default="" />
    <xacro:property name="p" value="$(arg prefix)" />

    <group name="lift">
        <chain base_link="${p}lift_base_link" tip_link="${p}lift_mount_link" />
    </group>
    <group name="ur">
        <chain base_link="${p}ur_base_link" tip_link="${p}ur_ft_frame" />
    </group>
    <group name="all">
        <chain base_link="${p}lift_base_link" tip_link="${p}ur_ft_frame" />
    </group>

    <virtual_joint name="world_joint" type="fixed" parent_frame="world"
        child_link="${p}lift_base_link" />

    <!-- DISABLE COLLISIONS -->
    <disable_collisions link1="${p}group_a_camera_link" link2="${p}ur_wrist_1_link" reason="Never" />
    <disable_collisions link1="${p}group_a_camera_link" link2="${p}ur_wrist_2_link" reason="Never" />
    <disable_collisions link1="${p}group_a_camera_link" link2="${p}ur_wrist_3_link"
        reason="Adjacent" />
    <disable_collisions link1="${p}lift_base_link" link2="${p}lift_lower_link" reason="Adjacent" />
    <disable_collisions link1="${p}lift_base_link" link2="${p}lift_mount_link" reason="Never" />
    <disable_collisions link1="${p}lift_base_link" link2="${p}lift_plate_link" reason="Adjacent" />
    <disable_collisions link1="${p}lift_base_link" link2="${p}lift_upper_link" reason="Default" />
    <disable_collisions link1="${p}lift_base_link" link2="${p}ur_base_link_inertia" reason="Never" />
    <disable_collisions link1="${p}lift_base_link" link2="${p}ur_shoulder_link" reason="Never" />
    <disable_collisions link1="${p}lift_lower_link" link2="${p}lift_mount_link" reason="Never" />
    <disable_collisions link1="${p}lift_lower_link" link2="${p}lift_plate_link" reason="Never" />
    <disable_collisions link1="${p}lift_lower_link" link2="${p}lift_upper_link" reason="Adjacent" />
    <disable_collisions link1="${p}lift_lower_link" link2="${p}ur_base_link_inertia" reason="Never" />
    <disable_collisions link1="${p}lift_lower_link" link2="${p}ur_shoulder_link" reason="Never" />
    <disable_collisions link1="${p}lift_lower_link" link2="${p}ur_upper_arm_link" reason="Never" />
    <disable_collisions link1="${p}lift_mount_link" link2="${p}lift_plate_link" reason="Never" />
    <disable_collisions link1="${p}lift_mount_link" link2="${p}lift_upper_link" reason="Adjacent" />
    <disable_collisions link1="${p}lift_mount_link" link2="${p}ur_base_link_inertia"
        reason="Adjacent" />
    <disable_collisions link1="${p}lift_mount_link" link2="${p}ur_shoulder_link" reason="Never" />
    <disable_collisions link1="${p}lift_plate_link" link2="${p}lift_upper_link" reason="Never" />
    <disable_collisions link1="${p}lift_plate_link" link2="${p}ur_base_link_inertia" reason="Never" />
    <disable_collisions link1="${p}lift_plate_link" link2="${p}ur_shoulder_link" reason="Never" />
    <disable_collisions link1="${p}lift_plate_link" link2="${p}ur_upper_arm_link" reason="Never" />
    <disable_collisions link1="${p}lift_upper_link" link2="${p}ur_base_link_inertia" reason="Never" />
    <disable_collisions link1="${p}lift_upper_link" link2="${p}ur_shoulder_link" reason="Never" />
    <disable_collisions link1="${p}lift_upper_link" link2="${p}ur_upper_arm_link" reason="Never" />
    <disable_collisions link1="${p}lift_upper_link" link2="${p}ur_wrist_1_link" reason="Never" />
    <disable_collisions link1="${p}ur_base_link_inertia" link2="${p}ur_shoulder_link"
        reason="Adjacent" />
    <disable_collisions link1="${p}ur_base_link_inertia" link2="${p}ur_upper_arm_link"
        reason="Never" />
    <disable_collisions link1="${p}ur_base_link_inertia" link2="${p}ur_wrist_1_link" reason="Never" />
    <disable_collisions link1="${p}ur_base_link_inertia" link2="${p}ur_wrist_2_link" reason="Never" />
    <disable_collisions link1="${p}ur_forearm_link" link2="${p}ur_upper_arm_link" reason="Adjacent" />
    <disable_collisions link1="${p}ur_forearm_link" link2="${p}ur_wrist_1_link" reason="Adjacent" />
    <disable_collisions link1="${p}ur_shoulder_link" link2="${p}ur_upper_arm_link" reason="Adjacent" />
    <disable_collisions link1="${p}ur_shoulder_link" link2="${p}ur_wrist_1_link" reason="Never" />
    <disable_collisions link1="${p}ur_shoulder_link" link2="${p}ur_wrist_2_link" reason="Never" />
    <disable_collisions link1="${p}ur_wrist_1_link" link2="${p}ur_wrist_2_link" reason="Adjacent" />
    <disable_collisions link1="${p}ur_wrist_1_link" link2="${p}ur_wrist_3_link" reason="Never" />
    <disable_collisions link1="${p}ur_wrist_2_link" link2="${p}ur_wrist_3_link" reason="Adjacent" />
</robot>