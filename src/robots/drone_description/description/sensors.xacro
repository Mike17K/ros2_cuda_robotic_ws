<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <!-- ===================== -->
    <!-- CAMERA -->
    <!-- ===================== -->
    <link name="camera_link">
        <inertial>
            <mass value="0.0" />
            <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0001" iyz="0.0" izz="0.0001" />
        </inertial>
        <visual>
            <geometry>
                <box size="0.02 0.08 0.02" />
            </geometry>
            <material name="red">
                <color rgba="1 0 0 1" />
            </material>
        </visual>
        <collision>
            <geometry>
                <box size="0.02 0.08 0.02" />
            </geometry>
        </collision>
    </link>

    <joint name="camera_joint" type="fixed">
        <parent link="base_link" />
        <child link="camera_link" />
        <origin xyz="0.2 0 0.0" rpy="0 0 0" />
    </joint>

    <gazebo reference="camera_link">
        <!-- Αλλαγή του type σε rgbd_camera -->
        <sensor name="drone_rgbd_camera" type="rgbd_camera">
            <always_on>1</always_on>
            <update_rate>30</update_rate>
            <visualize>true</visualize>
            <topic>/${robot_namespace}/camera/rgbd</topic>

            <camera>
                <optical_frame_id>/${robot_namespace}/camera_rgbd_optical_frame</optical_frame_id>

                <horizontal_fov>1.047</horizontal_fov>
                <image>
                    <width>640</width>
                    <height>480</height>
                    <format>R8G8B8</format>
                </image>
                <clip>
                    <near>0.05</near>
                    <far>10.0</far>
                </clip>
            </camera>
        </sensor>
    </gazebo>

    <link name="camera_rgbd_optical_frame" />
    <joint name="camera_rgbd_optical_frame_joint" type="fixed">
        <parent link="camera_link" />
        <child link="camera_rgbd_optical_frame" />
        <origin xyz="0 0 0" rpy="0 0 0" />
    </joint>


    <!-- ===================== -->
    <!-- IMU SENSOR (gz-sim)   -->
    <!-- ===================== -->
    <link name="imu_link">
        <inertial>
            <mass value="0.0" />
            <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0001" iyz="0.0" izz="0.0001" />
        </inertial>
        <visual>
            <geometry>
                <box size="0.02 0.02 0.02" />
            </geometry>
            <material name="blue">
                <color rgba="0 0 1 1" />
            </material>
        </visual>
        <collision>
            <geometry>
                <box size="0.02 0.02 0.02" />
            </geometry>
        </collision>
    </link>

    <gazebo reference="imu_link">
        <sensor name="imu_sensor" type="imu">
            <always_on>1</always_on>
            <update_rate>200</update_rate>
            <visualize>true</visualize>
            <topic>/${robot_namespace}/imu</topic>

            <plugin filename="gz-sim-imu-system"
                name="gz::sim::systems::Imu">
            </plugin>
        </sensor>
    </gazebo>

    <joint
        name="imu_joint" type="fixed">
        <parent link="base_link" />
        <child link="imu_link" />
    </joint>
    <!-- =====================  -->
    <!-- GPS SENSOR (gz-sim)   -->
    <!-- ===================== -->
    <!-- <link name="gps_link">
        <sensor name="navsat_sensor" type="navsat">
            <always_on>true</always_on>
            <update_rate>10</update_rate>
            <visualize>false</visualize>

            <plugin name="navsat_system" filename="gz-sim-navsat-system" />
        </sensor>
    </link>

    <joint name="gps_joint" type="fixed">
        <parent link="base_link" />
        <child link="gps_link" />
    </joint> -->

    <gazebo>
        <plugin
            filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
            <render_engine>ogre2</render_engine>
        </plugin>
    </gazebo>
</robot>