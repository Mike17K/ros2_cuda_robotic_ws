<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="combined_system">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />

    <!-- Import combined_system urdf file -->
    <xacro:include filename="$(find group_a_description)/urdf/group_a.urdf.xacro" />

    <!-- Import control_xacro -->
    <xacro:include filename="combined_system.ros2_control.xacro" />


    <xacro:combined_system_ros2_control name="FakeSystem" initial_positions_file="$(arg initial_positions_file)"/>

</robot>
